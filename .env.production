# Production Environment Configuration
# DO NOT commit actual production values - use Azure Key Vault or secrets management

# API Settings
API_TITLE=Puget Sound Marine Forecast API
API_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Cache Settings
CACHE_UPDATE_INTERVAL_MINUTES=120

# Security Settings
ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com,*.azurecontainerapps.io
LOG_LEVEL=WARNING

# External API Settings
NOAA_BASE_URL=https://tgftp.nws.noaa.gov/data/forecasts/marine/coastal/pz
NOAA_TIMEOUT_SECONDS=30

# Rate Limiting (Strict for production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
