# Test Environment Configuration
# Used for CI/CD testing and staging

# API Settings
API_TITLE=Puget Sound Marine Forecast API (Test)
API_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=test

# Cache Settings
CACHE_UPDATE_INTERVAL_MINUTES=120

# Security Settings
ALLOWED_ORIGINS=https://test.example.com
ALLOWED_HOSTS=test.example.com
LOG_LEVEL=INFO

# External API Settings
NOAA_BASE_URL=https://tgftp.nws.noaa.gov/data/forecasts/marine/coastal/pz
NOAA_TIMEOUT_SECONDS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
