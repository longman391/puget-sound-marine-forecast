# Puget Sound Marine Forecast — Environment Configuration
# Copy to .env and customize for your deployment.

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Auth — leave empty to disable API key auth (open access)
API_KEY=

# CORS — comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=*

# Cache — how often (in minutes) to refresh forecasts from NOAA
CACHE_INTERVAL_MINUTES=60

# Data sources (defaults are correct for production; override only for testing)
# NOAA_BASE_URL=https://tgftp.nws.noaa.gov/data/forecasts/marine/coastal/pz
# UW_SYNOPSIS_URL=https://a.atmos.washington.edu/data/marine_report.html
# NOAA_TIMEOUT_SECONDS=30

# MCP server — set to false to disable the MCP endpoint
MCP_ENABLED=true

# Timezone for display purposes
TZ=America/Los_Angeles
